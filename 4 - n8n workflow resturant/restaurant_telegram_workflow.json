{
  "name": "Restaurant Webhook - Reservation & Cancellation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restaurant",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -736,
        64
      ]
    },
    
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
              {
              "id": "cond-event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "reservation",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route-event",
      "name": "Route Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -272,
        64
      ]
    },
    {
      "parameters": {
        "chatId": "6863761231",
        "text": "=✅ **NEW RESERVATION RECEIVED!**\n\n📋 Booking Details:\n━━━━━━━━━━━━━━━━━\n👤 Name: {{ $json.body.customer_name }}\n📅 Date: {{ $json.body.date }}\n🕐 Time: {{ $json.body.time }}\n👥 Party Size: {{ $json.body.party_size }} guests\n📧 Contact: {{ $json.body.contact || \"Not provided\" }}\n🆔 Booking ID: #{{ $json.body.id }}\n⏱️ Timestamp: {{ $json.body.timestamp }}\n\n✔️ Status: CONFIRMED\n\nPlease prepare the table accordingly.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        0,
        -128
      ],
      "id": "notify-reservation",
      "name": "Notify: Reservation",
      "webhookId": "585816f7-ccc6-4502-96aa-e78aea145f04",
      "credentials": {
        "telegramApi": {
          "id": "NvOezTqJ2HMhJeFk",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "6863761231",
        "text": "=❌ **RESERVATION CANCELLED**\n\n📋 Cancellation Details:\n━━━━━━━━━━━━━━━━━\n🆔 Booking ID: #{{ $json.body.id }}\n👤 Name: {{ $json.body.customer_name }}\n📅 Date: {{ $json.body.date }}\n🕐 Time: {{ $json.body.time }}\n🪑 Party Size: {{ $json.body.party_size }}\n⏱️ Timestamp: {{ $json.body.timestamp }}\n\n⚠️ Status: CANCELLED\n\nPlease remove this reservation from the system.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        0,
        128
      ],
      "id": "notify-cancellation",
      "name": "Notify: Cancellation",
      "webhookId": "585816f7-ccc6-4502-96aa-e78aea145f04",
      "credentials": {
        "telegramApi": {
          "id": "NvOezTqJ2HMhJeFk",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', message: 'Reservation received and processed', booking_id: $json.body.id, event: $json.body.event, timestamp: $json.body.timestamp } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-success",
      "name": "Respond: Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        272,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Route Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Event": {
      "main": [
        [
          {
            "node": "Notify: Reservation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify: Cancellation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify: Reservation": {
      "main": [
        [
          {
            "node": "Respond: Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify: Cancellation": {
      "main": [
        [
          {
            "node": "Respond: Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
